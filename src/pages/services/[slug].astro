---
import Icon from "@components/Icon.astro";
import { contact, servicePages, services } from "@data/content";
import "@styles/global.css";

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const canonical = `https://www.99marketingservices.com/services/${service.slug}/`;
const title = `${service.metaTitle} | 99 Marketing Services`;
const description = service.metaDescription;
const related = services.filter((item) => item.slug !== service.slug).slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: service.title,
  provider: {
    "@type": "ProfessionalService",
    name: "99 Marketing Services",
    url: "https://www.99marketingservices.com/",
    telephone: "+91-8700-979899",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Phase 10",
      addressLocality: "Mohali",
      addressRegion: "Punjab",
      postalCode: "160062",
      addressCountry: "IN",
    },
  },
  areaServed: ["Mohali", "Punjab", "India", "Global"],
  description,
  url: canonical,
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="99 Marketing Services" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.99marketingservices.com/assets/marketing-command-center.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" aria-label="Main navigation">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="99 Marketing Services home">
          <span class="brand-mark" aria-hidden="true">99</span>
          <span>
            <strong>99 Marketing</strong>
            <span>Services</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Primary">
          <a href="/#services">Services</a>
          <a href="/#approach">Approach</a>
          <a href="/#packages">Packages</a>
          <a href="/#results">Results</a>
          <a href="/#contact">Contact</a>
        </nav>
        <a class="button button-primary header-cta" href={contact.calendly} target="_blank" rel="noopener noreferrer">
          Book Free Consultation
        </a>
      </div>
    </header>

    <main id="main">
      <section class="service-hero section-pad">
        <div class="container service-hero-grid">
          <div>
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span>/</span>
              <a href="/#services">Services</a>
              <span>/</span>
              <span>{service.title}</span>
            </nav>
            <p class="brand-line">We Market. You Win</p>
            <h1>{service.headline}</h1>
            <p class="hero-lede">{service.summary}</p>
            <div class="hero-actions">
              <a class="button button-primary" href={contact.calendly} target="_blank" rel="noopener noreferrer">
                Book Free Consultation
                <Icon name="arrow" />
              </a>
              <a class="button button-secondary" href="/#services">View All Services</a>
            </div>
          </div>
          <aside class="service-aside" aria-label={`${service.title} summary`}>
            <Icon name={service.icon} />
            <h2>{service.title}</h2>
            <p>{service.copy}</p>
          </aside>
        </div>
      </section>

      <section class="service-detail-section">
        <div class="container service-detail-grid">
          <div class="detail-panel">
            <h2>What We Build</h2>
            <ul class="check-list compact service-list">
              {service.deliverables.map((item) => <li><Icon name="check" />{item}</li>)}
            </ul>
          </div>
          <div class="detail-panel dark">
            <h2>Business Outcomes</h2>
            <ul class="outcome-list">
              {service.outcomes.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section-pad related-services" aria-labelledby="related-title">
        <div class="container">
          <div class="section-heading">
            <h2 id="related-title">Related Growth Services</h2>
            <p>Combine services into one accountable growth system when acquisition, tracking, and conversion need to move together.</p>
          </div>
          <div class="related-grid">
            {
              related.map((item) => (
                <a class="service-card" href={`/services/${item.slug}/`}>
                  <Icon name={item.icon} />
                  <h3>{item.title}</h3>
                  <p>{item.copy}</p>
                  <span class="service-link">Learn more</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="contact-band" id="contact" aria-labelledby="contact-title">
        <div class="container contact-grid">
          <div>
            <h2 id="contact-title">Get a practical growth plan.</h2>
            <p>Share your current channels, targets, and website. We will map the fastest next steps for measurable improvement.</p>
          </div>
          <div class="contact-details">
            <a href={contact.phoneHref}><Icon name="phone" />{contact.phoneDisplay}</a>
            <a href={contact.emailHref}><Icon name="mail" />{contact.email}</a>
            <span><Icon name="pin" />{contact.address}</span>
          </div>
          <a class="button button-light" href={contact.calendly} target="_blank" rel="noopener noreferrer">
            Book Free Consultation
            <Icon name="arrow" />
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
